# LLM API (OpenRouter — the only external dependency)
# Get your API key at: https://openrouter.ai/keys
# Token consumption is high; start with simulations of fewer than 40 rounds
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=openai/gpt-4o-mini

# ===== Boost LLM config (optional) =====
# If you don't use the boost config, remove the entries below from the env file
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== Local graph store (optional) =====
# Memory graphs are stored locally in backend/uploads/zep_local/graph.db by default
# ZEP_LOCAL_STORE=/path/to/graph.db
